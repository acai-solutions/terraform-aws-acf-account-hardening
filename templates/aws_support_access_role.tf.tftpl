resource "aws_iam_role" "aws_support_access_role_${primary_region_formatted}" {
  name               = "AWS_Support_Access_Role"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Action    = "sts:AssumeRole"
      Effect    = "Allow"
      Principal = {
          ${trust_principal_string}
      }
    }]
  })

  tags = local.tags
}

resource "aws_iam_role_policy_attachment" "aws_support_access_policy_${primary_region_formatted}" {
  role       = aws_iam_role.aws_support_access_role_${primary_region_formatted}.name
  policy_arn = "arn:aws:iam::aws:policy/AWSSupportAccess"  
}
