resource "aws_ebs_encryption_by_default" "default_ebs_encryption_${primary_region_formatted}" {
  enabled  = true
  provider = aws
}

%{ for region in secondary_regions ~}
resource "aws_ebs_encryption_by_default" "default_ebs_encryption_${lower(replace(region, "-", "_"))}" {
  enabled  = true
  provider = aws.${lower(replace(region, "-", "_"))}
}

%{ endfor ~}
